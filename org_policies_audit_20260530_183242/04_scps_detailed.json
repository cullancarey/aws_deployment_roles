{
  "service_control_policies": [
    {
      "id": "p-FullAWSAccess",
      "policy": {
        "Policy": {
          "PolicySummary": {
            "Id": "p-FullAWSAccess",
            "Arn": "arn:aws:organizations::aws:policy/service_control_policy/p-FullAWSAccess",
            "Name": "FullAWSAccess",
